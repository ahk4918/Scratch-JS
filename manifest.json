{
  "manifest_version": 3,
  "name": "Scratch JS Editor",
  "version": "0.2.0",
  "description": "Adds a Monaco-powered JavaScript editor overlay to Scratch when browsing Scratch in Firefox.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://scratch.mit.edu/projects/*/editor/*"],
      "js": ["dist/js-editor-extension.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*.js", "dist/*.ttf"],
      "matches": ["*://scratch.mit.edu/projects/*/editor/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "scratch-js-editor@example.com",
      "strict_min_version": "109.0"
    }
  }
}
